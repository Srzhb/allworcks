<!-- Educational Wazuh 4.12 manager rules. Reserve these IDs before installation.
     Validate decoder fields and correlation counters on your installed version.
     Explicit native parents keep Windows rules in the ossec category and in
     the already selected built-in Windows event tree.
     This file is NOT consumed by the offline Python analyzer. -->
<group name="local,lab_soc,">
  <rule id="110001" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <description>Lab: Windows failed logon for $(win.eventdata.targetUserName)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="110002" level="10" frequency="5" timeframe="300">
    <if_matched_sid>110001</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.system.computer</same_field>
    <description>Lab: repeated Windows failed logons on one host and account; review credentials and source</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="110010" level="5">
    <if_group>authentication_failed</if_group>
    <program_name>^sshd$</program_name>
    <description>Lab: Linux SSH authentication failure</description>
    <group>lab_ssh_failure,</group>
  </rule>

  <rule id="110011" level="10" frequency="5" timeframe="300">
    <if_matched_sid>110010</if_matched_sid>
    <same_user />
    <description>Lab: repeated Linux SSH failures for one user on one agent</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="110020" level="0">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(?:^|\\)(?:powershell|pwsh)\.exe$</field>
    <description>Lab: Sysmon PowerShell process baseline</description>
  </rule>

  <rule id="110021" level="8">
    <if_sid>110020</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|\s)-(?:encodedcommand|enc)(?:\s|:|$)</field>
    <description>Lab: PowerShell encoded-command flag; inspect approved automation</description>
    <group>powershell_review,</group>
  </rule>

  <rule id="110022" level="12">
    <if_sid>110020</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?=.*\b(?:iex|invoke-expression)\b)(?=.*\b(?:downloadstring|downloadfile|invoke-webrequest|iwr)\b)</field>
    <description>Lab: PowerShell download and expression-execution indicators; review script provenance</description>
    <group>powershell_review,</group>
  </rule>
</group>
