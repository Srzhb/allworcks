<!-- Merge localfile blocks into the existing Windows agent ossec.conf.
     Requires audit events and a separately installed/configured Sysmon. -->
<ossec_config>
  <localfile>
    <location>Security</location>
    <log_format>eventchannel</log_format>
    <query>Event/System[EventID=4624 or EventID=4625]</query>
  </localfile>
  <localfile>
    <location>Microsoft-Windows-Sysmon/Operational</location>
    <log_format>eventchannel</log_format>
    <query>Event/System[EventID=1]</query>
  </localfile>
</ossec_config>
