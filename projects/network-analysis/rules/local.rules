# Demonstration signatures. Run offline against the included synthetic PCAP.
# The generator does not execute Suricata or fabricate actual engine output.
alert dns any any -> any 53 (msg:"LAB synthetic beacon domain"; flow:to_server; dns.query; content:"beacon.example.test"; nocase; startswith; endswith; sid:1000001; rev:1;)
alert http any any -> any any (msg:"LAB executable URI suffix"; flow:established,to_server; http.uri.raw; content:".exe"; nocase; endswith; sid:1000002; rev:1;)
